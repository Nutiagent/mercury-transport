# ─── Public site ─────────────────────────────────────────────
# Production URL, used for canonical links, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.ee
# Set to "false" on staging/preview deployments to block search engines.
NEXT_PUBLIC_ALLOW_INDEXING=true

# ─── Quote form e-mail delivery (Resend, https://resend.com) ─
# Server-only. Without these three, the form honestly reports that delivery is not configured.
RESEND_API_KEY=
# Inbox(es) that receive enquiries, comma-separated.
QUOTE_TO_EMAIL=
# Verified sender in Resend, e.g. "Mercury veebileht <paring@your-domain.ee>"
QUOTE_FROM_EMAIL=

# Secret for signing anti-spam form tokens. Use a long random string (openssl rand -hex 32).
FORM_SECRET=

# ─── Optional ────────────────────────────────────────────────
# Cookieless analytics (Plausible). Leave empty to disable all tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Replace the procedural 3D truck with a licensed GLB, e.g. /models/truck.glb
NEXT_PUBLIC_HERO_MODEL_URL=
